  "questions": [
    {
      "id": "in_transfer_total",
      "class": "point",
      "cypher": "MATCH (src:Account { _workspace_id: $workspace_id })-[t:TRANSFER]->(dst:Account { _workspace_id: $workspace_id, acct_no: $acct_no }) RETURN count(t) AS n, sum(t.amount) AS total LIMIT $limit"
    },
    {
      "id": "two_hop_reach",
      "class": "point",
      "cypher": "MATCH (start:Account { _workspace_id: $workspace_id, acct_no: $acct_no })-[t:TRANSFER*1..2]->(reach:Account { _workspace_id: $workspace_id }) WHERE reach <> start RETURN count(DISTINCT reach) AS reachable LIMIT $limit"
    },
    {
      "id": "owner_portfolio",
      "class": "point",
      "cypher": "MATCH (o:Person|Company { _workspace_id: $workspace_id })-[r1:OWN]->(a:Account { _workspace_id: $workspace_id, acct_no: $acct_no }) MATCH (o)-[r2:OWN]->(b:Account { _workspace_id: $workspace_id }) RETURN o.id AS owner, count(DISTINCT b) AS accounts LIMIT $limit"
    },
    {
      "id": "recent_page",
      "class": "point",
      "cypher": "MATCH (a:Account { _workspace_id: $workspace_id, acct_no: $acct_no })-[t:TRANSFER]->(b:Account { _workspace_id: $workspace_id }) RETURN b.acct_no AS acct, t.amount AS amount, t.ts AS ts ORDER BY t.ts DESC LIMIT $limit"
    },
    {
      "id": "ubo_chain",
      "class": "point",
      "cypher": "MATCH (p:Person { _workspace_id: $workspace_id })-[i:INVEST]->(c:Company { _workspace_id: $workspace_id })-[o:OWN]->(a:Account { _workspace_id: $workspace_id }) RETURN count(DISTINCT p) AS ubo_candidates LIMIT $limit"
    },
    {
      "id": "ubo_depth",
      "class": "sweep",
      "cypher": "MATCH (o:Person|Company {_workspace_id: $workspace_id})-[:OWN]->(a:Account {_workspace_id: $workspace_id}) WITH o, count(a) AS held WHERE held >= $min_accounts RETURN o.id AS owner, held ORDER BY held DESC LIMIT $limit"
    },
    {
      "id": "guarantee_chain",
      "class": "sweep",
      "cypher": "MATCH (x:Person|Company {_workspace_id: $workspace_id})-[g1:GUARANTEE]->(y:Person|Company {_workspace_id: $workspace_id})-[g2:GUARANTEE]->(z:Person|Company {_workspace_id: $workspace_id}) WITH x, count(*) AS chains RETURN count(x) AS chain_starters, sum(chains) AS chains LIMIT $limit"
    },
    {
      "id": "rail_mix",
      "class": "point",
      "cypher": "MATCH (a:Account { _workspace_id: $workspace_id, acct_no: $acct_no })-[u:USES_CHANNEL]->(c:Channel { _workspace_id: $workspace_id }) RETURN c.code AS channel, sum(u.tx_count) AS transactions ORDER BY transactions DESC LIMIT $limit"
    },
    {
      "id": "risky_rail_senders",
      "class": "point",
      "cypher": "MATCH (src:Account { _workspace_id: $workspace_id })-[t:TRANSFER]->(dst:Account { _workspace_id: $workspace_id, acct_no: $acct_no }) WHERE t.channel_risk >= $risk_weight RETURN count(t) AS risky_transfers, sum(t.amount) AS risky_amount LIMIT $limit"
    },
    {
      "id": "structuring_fanin",
      "class": "sweep",
      "cypher": "MATCH (src:Account {_workspace_id: $workspace_id})-[t:TRANSFER]->(dst:Account {_workspace_id: $workspace_id, acct_no: $acct_no}) WITH src, count(t) AS k WHERE k >= $min_count RETURN src.acct_no AS sender, k ORDER BY k DESC LIMIT $limit"
    },
    {
      "id": "sub_threshold_inflow",
      "class": "point",
      "cypher": "MATCH (src:Account { _workspace_id: $workspace_id })-[t:TRANSFER]->(dst:Account { _workspace_id: $workspace_id, acct_no: $acct_no }) WHERE t.amount < $amount_max RETURN count(t) AS n, sum(t.amount) AS total LIMIT $limit"
    },
    {
      "id": "loan_disbursement_path",
      "class": "point",
      "cypher": "MATCH (l:Loan { _workspace_id: $workspace_id })-[d:DEPOSIT]->(x:Account { _workspace_id: $workspace_id })-[t:TRANSFER*1..3]->(dst:Account { _workspace_id: $workspace_id, acct_no: $acct_no }) RETURN count(DISTINCT l) AS loans LIMIT $limit"
    },
    {
      "id": "loan_repay_imbalance",
      "class": "sweep",
      "cypher": "MATCH (a:Account {_workspace_id: $workspace_id})-[r:REPAY]->(l:Loan {_workspace_id: $workspace_id}) WITH l, sum(r.amount) AS repaid WHERE repaid < l.principal * $repaid_ratio RETURN l.id AS loan, l.principal AS principal, repaid ORDER BY repaid LIMIT $limit"
    }
  ],
