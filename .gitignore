# Generated graph snapshots: Parquet plus the CSV staging the bulk loader writes. 1.2 GB at
# SF1000, and reproducible from the generator with a fixed seed, so it does not belong here.
outputs/
*.parquet
*.duckdb

__pycache__/
*.py[cod]
.venv/
.env

# Dolt database files (added by bd init)
.dolt/
*.db

# Rust build artifacts for the native driver bench (330 MB; cargo rebuilds them)
bench/*/target/
rust-harness/target/

# The repo tracks exactly the two talk charts; everything else regenerates from scripts/.
figures/*
!figures/overview-p50.svg
!figures/overview-p99.svg
!figures/engineering-detail.svg
!figures/slo-tradeoff.svg
!figures/plan-hints-ab.svg
!figures/estimate-error.svg

# Raw profiler captures: regenerable, and enormous. A single nsys run here was 75 MB of
# .nsys-rep plus 237 MB of .sqlite, past GitHub's limit. The analysable outputs — the
# kern_sum / nvtx_sum / gpu_trace CSVs nsys stats derives, and the torch trace — are what a
# reader needs; the raw capture stays on the box that made it.
*.nsys-rep
*.sqlite
*.ncu-rep
**/torch/*.pt.trace.json*
