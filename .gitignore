# Generated graph snapshots: Parquet plus the CSV staging the bulk loader writes. 1.2 GB at
# SF1000, and reproducible from the generator with a fixed seed, so it does not belong here.
outputs/
*.parquet
*.duckdb

__pycache__/
*.py[cod]
.venv/
.env

# Dolt database files (added by bd init)
.dolt/
*.db

# Rust build artifacts for the native driver bench (330 MB; cargo rebuilds them)
bench/*/target/

# The repo tracks exactly the two talk charts; everything else regenerates from scripts/.
figures/*
!figures/overview-p50.svg
!figures/overview-p99.svg
!figures/engineering-detail.svg
